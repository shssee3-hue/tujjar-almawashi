rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : "guest";
    }

    // "owner" is the single system owner and counts as an admin everywhere.
    // Only the owner may: promote/demote admins, manage user accounts
    // (ban/unban, role), or change site settings — regular admins keep
    // ads/reports/breeds/regions moderation only.
    function isAdmin() {
      return myRole() == "admin" || myRole() == "owner";
    }

    function isSystemOwner() {
      return myRole() == "owner";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // users/{uid} — profile documents keyed by auth uid
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId)
        && request.resource.data.role == "user";
      allow update: if isSystemOwner()
        || (isOwner(userId)
            // owners can edit their own profile but never escalate role/ban/rating/reportsCount
            && request.resource.data.role == resource.data.role
            && request.resource.data.banned == resource.data.banned
            && request.resource.data.rating == resource.data.rating
            && request.resource.data.reportsCount == resource.data.reportsCount);
      allow delete: if isSystemOwner();
    }

    // ads/{adId}
    match /ads/{adId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == "active";
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.sellerId == request.auth.uid
            && request.resource.data.sellerId == resource.data.sellerId);
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.sellerId == request.auth.uid);
    }

    // reports/{reportId}
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // breeds/{breedId} — admin-managed reference data, public read
    match /breeds/{breedId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // regions/{regionId} — admin-managed reference data, public read
    match /regions/{regionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // settings/site — single site-wide settings document
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSystemOwner();
    }
  }
}
