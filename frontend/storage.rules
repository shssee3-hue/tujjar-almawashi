rules_version = '2';

// Cloud Storage layout, written by src/lib/storage.ts:
//   ad-images/{uid}/...            — a seller's ad photos
//   commission-receipts/{uid}/...  — a seller's "تم البيع" payment receipts
//
// The Firestore doc only ever stores the resulting download URL. That URL
// carries its own access token (getDownloadURL), so an admin viewing a
// receipt from the dashboard works even though the path below is
// owner-only for direct access.

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // A compressed JPEG produced by fileToCompressedBlob() — cap well above
    // its ~0.35 MB target but far below anything abusive, and images only.
    function isAllowedImage() {
      return request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /ad-images/{uid}/{file=**} {
      allow read: if true;
      allow write: if isOwner(uid) && isAllowedImage();
      allow delete: if isOwner(uid);
    }

    match /commission-receipts/{uid}/{file=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isAllowedImage();
      allow delete: if isOwner(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
