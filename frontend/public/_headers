# Response headers for Cloudflare Pages — the project's sole host.
# (Firebase Hosting was retired; its firebase.json "hosting" block, which
# used to carry the equivalent rules, has been removed.)

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cache-Control: public, no-cache, must-revalidate

# Hashed build assets are immutable — cache them hard. This more specific
# rule overrides the Cache-Control above for this path.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
