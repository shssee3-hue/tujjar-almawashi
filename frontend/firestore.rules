rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : "guest";
    }

    // "owner" is the single system owner and counts as an admin everywhere.
    // Only the owner may: promote/demote admins, manage user accounts
    // (ban/unban, role), or change site settings — regular admins keep
    // ads/reports/breeds/regions moderation only.
    function isAdmin() {
      return myRole() == "admin" || myRole() == "owner";
    }

    function isSystemOwner() {
      return myRole() == "owner";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // users/{uid} — profile documents keyed by auth uid.
    // Only the owner may read another user's document (list/admin views);
    // everyone else may only read their own — nothing in the public-facing
    // app needs to read another user's profile (ad listings show seller
    // info via denormalized fields on the ad itself, not a users lookup).
    match /users/{userId} {
      allow read: if isOwner(userId) || isSystemOwner();
      allow create: if isOwner(userId)
        && request.resource.data.role == "user";
      allow update: if isSystemOwner()
        || (isOwner(userId)
            // owners can edit their own profile but never escalate role/ban/rating/reportsCount
            && request.resource.data.role == resource.data.role
            && request.resource.data.banned == resource.data.banned
            && request.resource.data.rating == resource.data.rating
            && request.resource.data.reportsCount == resource.data.reportsCount);
      allow delete: if isSystemOwner();
    }

    // ads/{adId}
    match /ads/{adId} {
      allow read: if true;
      // oathAccepted enforces the mandatory commission-acknowledgment checkbox
      // at the database layer, not just in the UI — a direct API/SDK call
      // that omits it (or sets it to anything but true) is rejected here
      // regardless of what the client claims to have shown the user.
      allow create: if isSignedIn()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == "active"
        && request.resource.data.oathAccepted == true;
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.sellerId == request.auth.uid
            && request.resource.data.sellerId == resource.data.sellerId);
      // Permanent (hard) deletion is an owner-only "sensitive review" action;
      // everyone else removes an ad via update (status -> "deleted"), which
      // stays reversible and is already covered by the update rule above.
      allow delete: if isSystemOwner();
    }

    // comments/{commentId} — per-ad discussion
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ratings/{adId_userId} — one rating per user per ad, id enforces that.
    // A seller may not rate their own ad — checked here, not just in the UI,
    // by looking up the ad's sellerId directly.
    match /ratings/{ratingId} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && ratingId == request.resource.data.adId + "_" + request.auth.uid
        && get(/databases/$(database)/documents/ads/$(request.resource.data.adId)).data.sellerId != request.auth.uid;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // reports/{reportId}
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // breeds/{breedId} — admin-managed reference data, public read
    match /breeds/{breedId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // regions/{regionId} — admin-managed reference data, public read
    match /regions/{regionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // settings/site — single site-wide settings document
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSystemOwner();
    }
  }
}
