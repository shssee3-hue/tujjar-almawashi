rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : "guest";
    }

    // "owner" is the single system owner and counts as an admin everywhere.
    // Only the owner may: promote/demote admins, manage user accounts
    // (ban/unban, role), or change site settings — regular admins keep
    // ads/reports/breeds/regions moderation only.
    function isAdmin() {
      return myRole() == "admin" || myRole() == "owner";
    }

    function isSystemOwner() {
      return myRole() == "owner";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // users/{uid} — profile documents keyed by auth uid.
    // Only the owner may read another user's document (list/admin views);
    // everyone else may only read their own — nothing in the public-facing
    // app needs to read another user's profile (ad listings show seller
    // info via denormalized fields on the ad itself, not a users lookup).
    match /users/{userId} {
      allow read: if isOwner(userId) || isSystemOwner();
      // rating/reportsCount/adsCount must start at their guaranteed initial
      // value too — a direct API call (bypassing createUserProfile())
      // could otherwise self-assign a fake 5-star rating from day one.
      allow create: if isOwner(userId)
        && request.resource.data.role == "user"
        && request.resource.data.rating == 0
        && request.resource.data.reportsCount == 0
        && request.resource.data.adsCount == 0;
      allow update: if isSystemOwner()
        || (isOwner(userId)
            // owners can edit their own profile but never escalate role/ban/rating/reportsCount.
            // "banned" is never set at profile creation (only an admin ever
            // writes it later via setUserBanned), so direct dot access would
            // throw and deny this whole rule for every never-banned account —
            // i.e. almost everyone — hence get() with a default here.
            && request.resource.data.role == resource.data.role
            && request.resource.data.get("banned", false) == resource.data.get("banned", false)
            && request.resource.data.rating == resource.data.rating
            && request.resource.data.reportsCount == resource.data.reportsCount);
      allow delete: if isSystemOwner();
    }

    // ads/{adId}
    match /ads/{adId} {
      allow read: if true;

      function ownSellerProfile() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }

      // oathAccepted enforces the mandatory commission-acknowledgment checkbox
      // at the database layer, not just in the UI — a direct API/SDK call
      // that omits it (or sets it to anything but true) is rejected here
      // regardless of what the client claims to have shown the user.
      //
      // Every other trust/moderation-relevant field is pinned to its
      // guaranteed initial value too — a direct API call (bypassing
      // createAd()) could otherwise create an ad that is already
      // "featured" for free, pre-seeded with fake views/reports, or
      // impersonating a different seller identity (name/type/rating are
      // denormalized from the caller's own profile, so they're checked
      // against it rather than trusted as given).
      // price/category are checked too — "offers" is deliberately excluded
      // since it's a retired section no longer offered for new ads (existing
      // ones keep working as-is; this only constrains new creates).
      allow create: if isSignedIn()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerName == ownSellerProfile().name
        && request.resource.data.sellerType == ownSellerProfile().accountType
        && request.resource.data.sellerRating == ownSellerProfile().rating
        && request.resource.data.status == "active"
        && request.resource.data.oathAccepted == true
        && request.resource.data.views == 0
        && request.resource.data.reportsCount == 0
        && request.resource.data.price >= 0
        && request.resource.data.category in
            ["livestock", "feed", "equipment", "services", "transport"]
        && (!("featured" in request.resource.data) || request.resource.data.featured == false);

      // A non-admin owner may edit their own ad's content freely, but not
      // the fields that exist specifically to record moderation/trust state:
      // featured, reportsCount and views stay untouched, and status may only
      // move to "deleted" (the seller's own soft-delete) or "ended" (marking
      // it sold via "تم البيع", which is what starts the commission flow) —
      // not, say, back to "active" to quietly reverse an admin's "flagged"
      // decision.
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.sellerId == request.auth.uid
            && request.resource.data.sellerId == resource.data.sellerId
            // "featured" may be entirely absent on older/never-featured ads —
            // direct dot access on a missing key throws in rules and denies
            // the whole expression, so this must use get() with a default.
            && request.resource.data.get("featured", false) == resource.data.get("featured", false)
            && request.resource.data.reportsCount == resource.data.reportsCount
            && request.resource.data.views == resource.data.views
            && (request.resource.data.status == resource.data.status
                || request.resource.data.status == "deleted"
                || request.resource.data.status == "ended"))
        // The public view counter: open to anyone (including signed-out
        // visitors), but scoped so tightly it can't be used for anything
        // else — the only field allowed to change is "views", and only by
        // exactly +1 per call.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["views"])
            && request.resource.data.views == resource.data.views + 1)
        // The report-count bump createReport() performs right after filing
        // a report: any signed-in user (not just the seller/admin), scoped
        // just as tightly — only "reportsCount", only +1 per call. Without
        // this, a non-seller reporter's report doc saves fine but this
        // follow-up write always failed, surfacing as a false "تعذر إرسال
        // البلاغ" error and leaving the count permanently at 0.
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reportsCount"])
            && request.resource.data.reportsCount == resource.data.reportsCount + 1);

      // Permanent (hard) deletion is an owner-only "sensitive review" action;
      // everyone else removes an ad via update (status -> "deleted"), which
      // stays reversible and is already covered by the update rule above.
      allow delete: if isSystemOwner();
    }

    // comments/{commentId} — per-ad discussion. A reply is just a regular
    // comment with replyToId set to its parent's id; the UI only exposes
    // replying to the ad's own seller, but that's a UI-level convention, not
    // a security boundary — anyone signed in may already write a top-level
    // comment, so there is nothing extra to protect by restricting who sets
    // replyToId.
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // The only update ever allowed is an admin toggling "hidden" for
      // moderation — comment text/author can never be altered after posting.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["hidden"]);
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ratings/{adId_userId} — one rating per user per ad, id enforces that.
    // A seller may not rate their own ad — checked here, not just in the UI,
    // by looking up the ad's sellerId directly.
    match /ratings/{ratingId} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && ratingId == request.resource.data.adId + "_" + request.auth.uid
        && request.resource.data.value is int
        && request.resource.data.value >= 1
        && request.resource.data.value <= 5
        && get(/databases/$(database)/documents/ads/$(request.resource.data.adId)).data.sellerId != request.auth.uid;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // reports/{reportId}
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // breeds/{breedId} — admin-managed reference data, public read
    match /breeds/{breedId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // regions/{regionId} — admin-managed reference data, public read
    match /regions/{regionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // additionalServices/{serviceId} — admin-managed sub-categories for the
    // four non-livestock sections, public read (same pattern as breeds)
    match /additionalServices/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // counters/adCode — a single document tracking the sequential number
    // used to build each ad's human-readable "AD-2026-000123" adCode.
    // Reads are public (harmless), but writes are constrained to a strict
    // +1 within the same year (or reset to 1 on a year change) so a client
    // can never rewind the sequence, skip far ahead, or touch any other
    // field — createAd() is the only caller, via a Firestore transaction.
    match /counters/{counterId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(["year", "seq"])
        && request.resource.data.seq == 1;
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["year", "seq"])
        && ((request.resource.data.year == resource.data.year
              && request.resource.data.seq == resource.data.seq + 1)
            || (request.resource.data.year != resource.data.year
                && request.resource.data.seq == 1));
      allow delete: if false;
    }

    // settings/site — single site-wide settings document
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSystemOwner();
    }

    // commissions/{commissionId} — a seller's self-reported sale + the
    // commission owed on it, submitted via "تم البيع", reviewed by admin.
    match /commissions/{commissionId} {
      // A seller can see their own submissions (e.g. to check their status
      // later); admin/owner can see all of them for review.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.sellerId == request.auth.uid);
      // Only the ad's actual seller may file a claim for it, and only as
      // "pending" — nobody can create one that's already approved/rejected.
      allow create: if isSignedIn()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == "pending"
        && get(/databases/$(database)/documents/ads/$(request.resource.data.adId)).data.sellerId == request.auth.uid;
      // Only admin/owner can review it, and only the review fields —
      // the seller's original claim (amounts, receipt, payment method)
      // can never be edited after submission by anyone.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "reviewedAt"]);
      allow delete: if isAdmin();
    }

    // password_resets/{resetId} — OTP records for the phone-based "forgot
    // password" flow. Every legitimate reader/writer is the Cloud Functions
    // in functions/src/index.ts, which use the Admin SDK and so bypass
    // these rules entirely — a logged-out visitor requesting a reset has no
    // Firestore auth context of their own to grant access through anyway.
    // Denying all direct client access means an OTP (or the fact that one
    // exists for a given phone) can never be read, guessed at, or tampered
    // with by calling the Firestore API directly instead of going through
    // the Cloud Functions' own validation (expiry, attempt limit, etc).
    match /password_resets/{resetId} {
      allow read, write: if false;
    }
  }
}
